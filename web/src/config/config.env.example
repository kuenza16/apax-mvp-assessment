# This is a example .env file for use in local development.
# Copy to web/.env and run backend commands from web/. Never commit real secrets.

# The HTTP port to run the application on
PORT=4000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/apax

# JWT secret and expiry
# Required: generate a long random signing secret; empty value prevents startup.
JWT_SECRET=
# Positive duration with unit: ms, s, m, h, d, w, y. Default is 7d.
JWT_EXPIRE=7d

# Stripe API Key & Secret Key (Optional) **Alternative Paytm**
STRIPE_API_KEY=
STRIPE_SECRET_KEY=

# Any SMTP Credentials (Optional) **Alternative Sendgrid**
SMTP_HOST=
SMTP_PORT=
SMTP_SERVICE=
SMTP_MAIL=
SMTP_PASSWORD=

# Sendgrid Credentials
SENDGRID_API_KEY=
SENDGRID_MAIL=
SENDGRID_RESET_TEMPLATEID=
SENDGRID_ORDER_TEMPLATEID=

# Cloudinary Credentials
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paytm Credentials
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=
PAYTM_CHANNEL_ID=
PAYTM_INDUSTRY_TYPE=
PAYTM_CUST_ID=

# The environment to run the application in
NODE_ENV=development
